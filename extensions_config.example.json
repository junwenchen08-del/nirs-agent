{
  "mcpInterceptors": [],
  "mcpServers": {
    "chemotools": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "nir_core.chemotools_mcp.chemotools_server"
      ],
      "env": {},
      "description": "Pinned Chemotools 0.4.4 catalog, execution, diagnostics, and visualization"
    },
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "$DATABASE_URL"
      ],
      "env": {},
      "description": "Optional PostgreSQL access; set DATABASE_URL before enabling"
    }
  },
  "skills": {}
}
