# NIR-Agent environment template
#
# Copy this file to `.env`, then enable only the variables you need. This
# template is safe to commit; `.env` is not. Never paste real credentials into
# config.example.yaml or any tracked file.

# =============================================================================
# Docker and local access
# =============================================================================

# Unified Nginx entry port. The current Compose files may bind this port on all
# host interfaces; do not expose it directly to the public internet.
# PORT=2026

# Optional package mirrors for restricted networks.
# UV_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org
# APT_MIRROR=

# Optional outbound proxy. Internal container names are added to NO_PROXY by
# the bundled Compose files.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# =============================================================================
# Model providers -- enable at least one matching config.yaml model
# =============================================================================

# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_AUTH_TOKEN=replace-me
# GEMINI_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me
# MOONSHOT_API_KEY=replace-me
# MIMO_API_KEY=replace-me
# VOLCENGINE_API_KEY=replace-me
# NOVITA_API_KEY=replace-me
# STEPFUN_API_KEY=replace-me
# MINIMAX_API_KEY=replace-me
# ATLASCLOUD_API_KEY=replace-me
# VLLM_API_KEY=replace-me

# =============================================================================
# Optional search and browser providers
# =============================================================================

# SERPER_API_KEY=replace-me
# TAVILY_API_KEY=replace-me
# JINA_API_KEY=replace-me
# INFOQUEST_API_KEY=replace-me
# BRAVE_SEARCH_API_KEY=replace-me
# EXA_API_KEY=replace-me
# FIRECRAWL_API_KEY=replace-me
# GROUNDROUTE_API_KEY=replace-me
# CRW_API_KEY=replace-me
# BROWSERLESS_TOKEN=replace-me
# CRAWL4AI_TOKEN=replace-me

# =============================================================================
# Authentication and Gateway
# =============================================================================

# `make up` / scripts/deploy.sh generate and persist these automatically. Set
# them manually only when running services outside the bundled deployment path.
# BETTER_AUTH_SECRET=generate-a-long-random-value
# AUTH_JWT_SECRET=generate-a-different-long-random-value
# DEER_FLOW_INTERNAL_AUTH_TOKEN=generate-a-shared-random-value

# Browser CORS allowlist for split-origin deployments. Leave unset when using
# the unified http://localhost:2026 endpoint.
# GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEER_FLOW_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:2026

# Disable Swagger UI, ReDoc, and OpenAPI schema on an internet-facing Gateway.
# GATEWAY_ENABLE_DOCS=false

# =============================================================================
# NIR resource and artifact security
# =============================================================================

# Parser/modeling ceilings. The web upload limits in config.yaml are separate
# and must be reviewed together with these values before accepting larger data.
# NIR_MAX_FILE_BYTES=536870912
# NIR_MAX_MATRIX_ELEMENTS=50000000
# NIR_MAX_SAMPLES=100000
# NIR_MAX_WAVELENGTHS=50000
# NIR_MAX_TARGETS=256
# NIR_MAX_ESTIMATED_PEAK_BYTES=4294967296
# NIR_MAX_RUNTIME_SECONDS=900

# Recommended for production model artifacts. Generate a private random key,
# keep it outside Git, and enable enforcement only after all deployed artifacts
# have been signed with the same key.
# NIR_ARTIFACT_SIGNING_KEY=replace-with-a-long-random-secret
# NIR_REQUIRE_SIGNED_ARTIFACTS=1

# Optional preprocessing-provider rollback. The default catalog policy uses
# Chemotools only for methods with verified numerical adapters; old artifacts
# remain pinned to their saved/native provider regardless of this setting.
# NIR_PREPROCESSING_PROVIDER_POLICY=native

# Optional wavelength-domain and continuous-drift policy overrides.
# NIR_WAVELENGTH_MIN_NM=100
# NIR_WAVELENGTH_MAX_NM=50000
# NIR_DRIFT_ALERT_THRESHOLD=0.50
# NIR_DRIFT_ALERT_CONSECUTIVE_BATCHES=3
# NIR_DRIFT_RECOVERY_THRESHOLD=0.10
# NIR_DRIFT_RECOVERY_CONSECUTIVE_BATCHES=2

# =============================================================================
# Optional NIR knowledge base
# =============================================================================

# Basic NIR inspection, preprocessing, training, and prediction do not require
# these settings. Use container paths in Docker; do not copy host-specific
# Windows paths into a public configuration.
# NIR_KNOWLEDGE_URL=http://host.docker.internal:8089
# NIR_KNOWLEDGE_TOKEN=replace-me
# NIR_KNOWLEDGE_SEARCH_TIMEOUT_SECONDS=60
# UV_EXTRAS=knowledge
# NIR_KNOWLEDGE_EMBEDDING_MODEL=/models/bge-m3
# NIR_KNOWLEDGE_EMBEDDING_DIM=1024
# NIR_KNOWLEDGE_CHROMA_PATH=/data/nir-knowledge/chroma
# NIR_KNOWLEDGE_CATALOG_PATH=/data/nir-knowledge/catalog.sqlite3
# NIR_KNOWLEDGE_COLLECTION_NAME=nir_papers_bge_m3
# NIR_KNOWLEDGE_INDEX_VERSION=nir-papers-bge-m3-v1

# Optional second-stage reranker.
# NIR_KNOWLEDGE_RERANK_ENABLED=false
# NIR_KNOWLEDGE_RERANK_MODEL=/models/bge-reranker-v2-m3
# NIR_KNOWLEDGE_RERANK_DEVICE=auto
# NIR_KNOWLEDGE_RERANK_BATCH_SIZE=8
# NIR_KNOWLEDGE_RERANK_MAX_LENGTH=512
# NIR_KNOWLEDGE_RERANK_MAX_CANDIDATES=12

# Retrieval policy calibrated for the documented BGE-M3 benchmark.
# NIR_KNOWLEDGE_RETRIEVAL_CANDIDATE_MULTIPLIER=4
# NIR_KNOWLEDGE_RETRIEVAL_MAX_CANDIDATES=80
# NIR_KNOWLEDGE_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
# NIR_KNOWLEDGE_RETRIEVAL_STRONG_SCORE_THRESHOLD=0.63
# NIR_KNOWLEDGE_RETRIEVAL_WEAK_SCORE_THRESHOLD=0.60
# NIR_KNOWLEDGE_RETRIEVAL_MIN_DOCUMENT_MARGIN=0.02
# NIR_KNOWLEDGE_RETRIEVAL_ANSWERABILITY_ENABLED=true
# NIR_KNOWLEDGE_RETRIEVAL_DIVERSITY_ENABLED=true

# =============================================================================
# Optional sandbox, database, observability, and integrations
# =============================================================================

# E2B_API_KEY=replace-me
# DATABASE_URL=postgresql://user:password@database-host:5432/database-name
# KEYCLOAK_CLIENT_SECRET=replace-me
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=replace-me
# LANGSMITH_PROJECT=nir-agent
# GITHUB_TOKEN=replace-me

# FEISHU_APP_ID=replace-me
# FEISHU_APP_SECRET=replace-me
# SLACK_BOT_TOKEN=replace-me
# SLACK_APP_TOKEN=replace-me
# TELEGRAM_BOT_TOKEN=replace-me
# TELEGRAM_BOT_USERNAME=replace-me
# DISCORD_BOT_TOKEN=replace-me
# WECOM_BOT_ID=replace-me
# WECOM_BOT_SECRET=replace-me
# WECHAT_ILINK_BOT_ID=replace-me
# WECHAT_BOT_TOKEN=replace-me
# DINGTALK_CLIENT_ID=replace-me
# DINGTALK_CLIENT_SECRET=replace-me

# =============================================================================
# Advanced service wiring -- normally leave unset
# =============================================================================

# The bundled Compose files set the internal Gateway URL automatically.
# DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://localhost:8001

# Optional CLI-subscription credentials. Prefer a single token/file over
# mounting an entire ~/.claude or ~/.codex directory into a container.
# CLAUDE_CODE_OAUTH_TOKEN=replace-me
# CLAUDE_CODE_CREDENTIALS_PATH=/path/to/.claude/.credentials.json
# CODEX_AUTH_PATH=/path/to/codex/auth.json
