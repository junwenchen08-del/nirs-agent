      "task_type": "calibration",
      "user_message": "请用这份近红外数据建立模型。",
      "expected_route": "nir-coordinator",
      "expected_final_stages": ["intake"],
      "required_workflow_actions": ["start"],
      "expected_approval_status": "not_required",
      "tags": ["intake", "requirements"]
    },
    {
